{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Kinetic Drop",
    "version": "2.0",
    "source": "docs/design/design-system.md",
    "note": "Single source of truth. Generated outputs: Swift (apps/ios DesignSystem) + Tailwind (apps/web). Do not edit generated files."
  },
  "color": {
    "ink900": { "value": "#0E0E0E", "usage": "App background, screen base" },
    "ink800": { "value": "#131313", "usage": "Card surface, verification panel" },
    "ink700": { "value": "#1A1A1A", "usage": "Raised / hover card" },
    "ink600": { "value": "#262626", "usage": "Input background, elevated tile" },
    "ink500": { "value": "#2E2E2E", "usage": "Input hover / focus-ready" },
    "ink400": { "value": "#484847", "usage": "Placeholder glyph, disabled OTP dot" },
    "lime": { "value": "#CAFD00", "usage": "CTA fill, data-positive signal" },
    "limeSoft": { "value": "#F3FFCA", "usage": "Display headings, primary on-dark text" },
    "limeInk": { "value": "#516700", "usage": "Text on lime CTA (WCAG AA)" },
    "plasma": { "value": "#D277FF", "usage": "Links, NEW DROP badge, section titles" },
    "plasmaDeep": { "value": "#7D01B1", "usage": "Security/protocol icon tile" },
    "plasmaInk": { "value": "#380052", "usage": "Text on plasma badge" },
    "fog": { "value": "#ADAAAA", "usage": "Secondary text, captions, timestamps" },
    "fogMuted": { "value": "#7A7777", "usage": "Tertiary / inactive labels" },
    "white": { "value": "#FFFFFF", "usage": "Masked email, highlighted inline value" },
    "positive": { "value": "#10B981", "usage": "Up-tick badge, P&L gains (paired with sign, never color-only)" },
    "negative": { "value": "#EF4444", "usage": "Down-tick badge, P&L losses (paired with sign, never color-only)" }
  },
  "colorAlpha": {
    "limeGlow": { "base": "#CAFD00", "alpha": 0.20, "usage": "CTA drop-shadow glow" },
    "plasmaGlow": { "base": "#D277FF", "alpha": 0.20, "usage": "Plasma-variant button glow" },
    "edge": { "base": "#484847", "alpha": 0.20, "usage": "Card borders, glassmorphic outlines" },
    "edgeStrong": { "base": "#484847", "alpha": 0.40, "usage": "Focus rings, selected card borders" }
  },
  "gradient": {
    "limeDrop": { "from": "#F3FFCA", "to": "#CAFD00", "angle": 135, "usage": "Primary button gradient" },
    "plasmaDrop": { "from": "#D277FF", "to": "#7D01B1", "angle": 135, "usage": "Secondary button gradient" }
  },
  "spacing": {
    "space1": 4, "space2": 8, "space3": 12, "space4": 16, "space5": 20,
    "space6": 24, "space8": 32, "space10": 40, "space12": 48, "space16": 64, "space24": 96
  },
  "radius": {
    "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxxl": 40, "full": 9999
  },
  "typography": {
    "fonts": {
      "display": { "family": "Space Grotesk", "note": "headings, UI labels, numerics (tabular), tracked caps" },
      "body": { "family": "Manrope", "note": "body copy, descriptions, paragraphs" }
    },
    "scale": {
      "displayXl": { "size": 64, "weight": 700, "lineHeight": 1.05, "tracking": -1.8, "font": "display" },
      "displayLg": { "size": 44, "weight": 700, "lineHeight": 1.05, "tracking": -1.5, "font": "display" },
      "displayMd": { "size": 36, "weight": 700, "lineHeight": 1.25, "tracking": -1.8, "font": "display" },
      "displaySm": { "size": 24, "weight": 700, "lineHeight": 1.2, "tracking": -0.5, "font": "display" },
      "titleLg": { "size": 20, "weight": 400, "lineHeight": 1.4, "tracking": -1.0, "font": "display" },
      "titleMd": { "size": 18, "weight": 400, "lineHeight": 1.56, "tracking": -0.45, "font": "display" },
      "captionDrop": { "size": 14, "weight": 400, "lineHeight": 1.43, "tracking": 1.4, "uppercase": true, "font": "display" },
      "captionPulse": { "size": 12, "weight": 400, "lineHeight": 1.33, "tracking": 1.2, "uppercase": true, "font": "display" },
      "bodyLg": { "size": 18, "weight": 400, "lineHeight": 1.62, "tracking": 0, "font": "body" },
      "bodyMd": { "size": 14, "weight": 400, "lineHeight": 1.62, "tracking": 0, "font": "body" }
    }
  },
  "motion": {
    "duration": { "fast": 150, "standard": 300, "pulseGlow": 3000, "countdown": 1000 },
    "easing": {
      "standard": [0.4, 0, 0.2, 1],
      "decelerate": [0.0, 0, 0.2, 1],
      "accelerate": [0.4, 0, 1, 1],
      "spring": [0.34, 1.56, 0.64, 1]
    }
  },
  "layout": {
    "touchTargetMin": 44,
    "ctaHeight": 68,
    "bottomNavHeight": 64,
    "screenMargin": 24
  }
}
